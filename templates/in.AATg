# input file for AA annealing by JH

# ----- Initialization
processors      2 2 3
units           real
atom_style      full
timestep        1.0
neighbor        0.3 bin
neigh_modify    delay 0 every 1 check yes one 5000

# ----- Read Data
bond_style      harmonic 
angle_style     harmonic
dihedral_style  opls   

pair_style      lj/cut/coul/long 12.0 15.0
kspace_style    pppm 1.0e-5
special_bonds   lj 0.0 0.0 1.0 coul 0.0 0.0 1.0 dihedral yes

read_data       AAEQfin.data
thermo_style    custom step temp etotal pe ke emol epair press vol density
thermo          100

variable Tini   equal 80 
variable Tfin   equal 300

# ----- Initial minimization
min_style      cg
minimize       1.0e-8 1.0e-8 50000 200000

# ----- NVT
velocity  all  create ${Tini} 12345 mom yes rot yes dist gaussian
reset_timestep 0
fix            1 all npt temp ${Tini} ${Tini} 1.0 iso 1.0 1.0 1000.0
dump           1 all custom 10000 aa_tg_ini.lammpstrj id element xu yu zu vx vy vz
dump_modify    1 element C
run            50000

unfix     1
undump    1

# ----- Temp increase
reset_timestep 0
fix            1 all npt temp ${Tini} ${Tfin} 1.0 iso 1.0 1.0 1000.0
dump           1 all custom 10000 aa_tg_heating.lammpstrj id element xu yu zu vx vy vz
dump_modify    1 element C
run            500000

unfix     1
undump    1

# ----- Temp decrease
reset_timestep 0
fix            1 all npt temp ${Tfin} ${Tini} 1.0 iso 1.0 1.0 1000.0
dump           1 all custom 10000 aa_tg_cooling.lammpstrj id element xu yu zu vx vy vz
dump_modify    1 element C
run            3000000

unfix     1
undump    1