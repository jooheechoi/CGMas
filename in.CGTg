# input file for CG Annealing by JH

# ----- Initialization
processors      2 2 3
boundary 	    p p p
units 		    real
atom_style 	    angle
timestep        1.0

# ----- Read Data
bond_style      harmonic
angle_style     harmonic
pair_style      lj/cut 15

read_data       CGEQfin.data

bond_coeff      1 497.027355 2.425000
angle_coeff     1 11.246008 179.500000
pair_coeff      1 1 0.262201 4.207110

thermo_style    custom step temp etotal pe ke emol epair press vol density
thermo          100

variable Tini   equal 80 
variable Tfin   equal 300

# ----- Initial minimization
min_style cg
minimize 1e-15 1e-15 100000 100000

# ----- NVT
velocity all create ${Tini} 12345 mom yes rot yes dist gaussian
reset_timestep 0
fix            1 all npt temp ${Tini} ${Tini} 1.0 iso 1.0 1.0 1000.0
dump           1 all atom 10000 cg_tg_ini.lammpstrj
run            50000

unfix     1
undump    1

# ----- Temp increase
reset_timestep 0
fix            1 all npt temp ${Tini} ${Tfin} 1.0 iso 1.0 1.0 1000.0
dump           1 all atom 10000 cg_tg_heating.lammpstrj
run            500000

unfix     1
undump    1

# ----- Temp decrease
reset_timestep 0
fix            1 all npt temp ${Tfin} ${Tini} 1.0 iso 1.0 1.0 1000.0
dump           1 all atom 10000 cg_tg_cooling.lammpstrj
run            3000000

unfix     1
undump    1