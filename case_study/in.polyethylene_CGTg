# input file for CG Annealing by JH

# ----- Initialization
processors      2 2 3
boundary 	    p p p
units 		    real
atom_style 	    angle
timestep        1.0

# ----- Read Data
bond_style      harmonic
angle_style     harmonic
pair_style      lj/cut 15

read_data       CGEQfin.data

bond_coeff      1 35.829800 2.554200
angle_coeff     1 35.063000 179.204000
pair_coeff      1 1 0.606356 4.542400

thermo_style    custom step temp etotal pe ke emol epair press vol density
thermo          100

variable Tini   equal 80 
variable Tfin   equal 310

# ----- Initial minimization
min_style cg
minimize 1e-15 1e-15 100000 100000

# ----- NVT
velocity all create ${Tini} 12345 mom yes rot yes dist gaussian
reset_timestep 0
fix            1 all npt temp ${Tini} ${Tini} 1.0 iso 1.0 1.0 1000.0
dump           1 all atom 10000 ini.lammpstrj
run            50000

unfix     1
undump    1

# ----- Temp increase
reset_timestep 0
fix            1 all npt temp ${Tini} ${Tfin} 1.0 iso 1.0 1.0 1000.0
dump           1 all atom 10000 heating.lammpstrj
run            500000

unfix     1
undump    1

# ----- Temp decrease
reset_timestep 0
fix            1 all npt temp ${Tfin} ${Tini} 1.0 iso 1.0 1.0 1000.0
dump           1 all atom 10000 cooling.lammpstrj
run            500000

unfix     1
undump    1