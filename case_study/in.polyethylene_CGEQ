# input file for CGEQ by JH

# ----- Initialization
processors      2 2 3
boundary        p p p
units 		    real
atom_style  	angle
timestep        1.0

# ----- Read Data
read_data       polyethylene_cg_ini.data

bond_style      harmonic
bond_coeff      1 35.829800 2.554200  # [1, 1]

angle_style     harmonic
angle_coeff     1 35.063000 179.204000  # [1, 1, 1]

pair_style      lj/cut 15
pair_coeff      1 1 0.606356 4.542400  # [1, 1]

thermo_style    custom step temp etotal pe ke emol epair press vol density
thermo          100

variable Tini   equal 300
variable Tfin   equal 500
variable equil  equal 1000000

# ----- Initial minimization
min_style cg
minimize 1e-15 1e-15 100000 100000

# ----- NVT
velocity all create ${Tini} 12345 mom yes rot yes dist gaussian
reset_timestep 0
fix            1 all nvt temp ${Tini} ${Tini} 1000.0
dump           1 all atom 10000 cg_ini.lammpstrj
run            50000

unfix     1
undump    1

# ----- Temp increase
reset_timestep 0
fix            1 all nvt temp ${Tini} ${Tfin} 1000.0
dump           1 all atom 10000 cg_heating.lammpstrj
run            50000

unfix     1
undump    1

# ----- NVT
reset_timestep 0
fix            1 all nvt temp ${Tfin} ${Tfin} 1000.0
dump           1 all atom 10000 cg_holding.lammpstrj
run            50000

unfix     1
undump    1

# ----- Temp decrease
reset_timestep 0
fix            1 all nvt temp ${Tfin} ${Tini} 1000.0
dump           1 all atom 10000 cg_cooling.lammpstrj
run            50000

unfix     1
undump    1

# ----- NVT
reset_timestep 0
fix            1 all nvt temp ${Tini} ${Tini} 1000.0
dump           1 all atom 10000 cg_relaxing.lammpstrj
run            50000

unfix     1
undump    1

# ----- NPT
reset_timestep 0
fix            1 all npt temp ${Tini} ${Tini} 1.0 iso 1.0 1.0 1000.0
dump           1 all atom 10000 cg_fin.lammpstrj
run            ${equil}
write_data     CGEQfin.data

unfix     1
undump    1